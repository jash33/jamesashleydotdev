---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const reads = (await getCollection('reading'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Base title="Reading — James Ashley">
  <ul class="post-list">
    {reads.map((item) => (
      <li class="post-item">
        <p class="post-date">{formatDate(item.data.date)}</p>
        <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="post-title">{item.data.title}</a>
        {item.data.description && (
          <p class="post-description">{item.data.description}</p>
        )}
      </li>
    ))}
  </ul>
</Base>
